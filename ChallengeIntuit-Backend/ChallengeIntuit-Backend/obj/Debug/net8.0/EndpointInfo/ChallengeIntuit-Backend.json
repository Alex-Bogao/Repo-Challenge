{
  "openapi": "3.0.1",
  "info": {
    "title": "ChallengeIntuit-Backend",
    "version": "1.0"
  },
  "paths": {
    "/api/Clientes": {
      "get": {
        "tags": [
          "Clientes"
        ],
        "summary": "Obtiene el listado completo de clientes.",
        "responses": {
          "200": {
            "description": "Retorna la lista de clientes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Cliente"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Si ocurre un error interno en el servidor"
          }
        }
      }
    },
    "/api/Clientes/Get/{id}": {
      "get": {
        "tags": [
          "Clientes"
        ],
        "summary": "Obtiene un cliente específico por su ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "El ID del cliente a buscar.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Retorna el cliente solicitado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cliente"
                }
              }
            }
          },
          "404": {
            "description": "Si el cliente no existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Clientes/Buscar": {
      "get": {
        "tags": [
          "Clientes"
        ],
        "summary": "Busca clientes por nombre o apellido utilizando un Stored Procedure.",
        "parameters": [
          {
            "name": "texto",
            "in": "query",
            "description": "Texto a buscar dentro del nombre o apellido.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Retorna los clientes encontrados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Cliente"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Si no se envía texto de búsqueda",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Si no se encuentran coincidencias",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Clientes/Insert": {
      "post": {
        "tags": [
          "Clientes"
        ],
        "summary": "Crea un nuevo cliente en la base de datos.",
        "requestBody": {
          "description": "Datos del cliente a crear.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClienteDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ClienteDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ClienteDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Cliente creado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cliente"
                }
              }
            }
          },
          "400": {
            "description": "Si el CUIT o Email ya existen, o los datos son inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Clientes/Update/{id}": {
      "put": {
        "tags": [
          "Clientes"
        ],
        "summary": "Actualiza los datos de un cliente existente.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID del cliente a actualizar.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "description": "Nuevos datos del cliente.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClienteDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ClienteDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ClienteDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Actualización exitosa (sin contenido)"
          },
          "404": {
            "description": "Si el cliente no existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Clientes/Delete/{id}": {
      "delete": {
        "tags": [
          "Clientes"
        ],
        "summary": "Elimina un cliente por su ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID del cliente a eliminar.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Eliminación exitosa"
          },
          "404": {
            "description": "Si el cliente no existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Cliente": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "nombre": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "apellido": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "razonSocial": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "cuit": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "fechaNacimiento": {
            "type": "string",
            "format": "date"
          },
          "telefonoCelular": {
            "maxLength": 30,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "email": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "fechaCreacion": {
            "type": "string",
            "format": "date-time"
          },
          "fechaModificacion": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "ClienteDto": {
        "required": [
          "apellido",
          "cuit",
          "email",
          "fechaNacimiento",
          "nombre",
          "razonSocial",
          "telefonoCelular"
        ],
        "type": "object",
        "properties": {
          "nombre": {
            "minLength": 1,
            "type": "string"
          },
          "apellido": {
            "minLength": 1,
            "type": "string"
          },
          "razonSocial": {
            "minLength": 1,
            "type": "string"
          },
          "cuit": {
            "minLength": 1,
            "pattern": "^\\d{2}-\\d{8}-\\d{1}$",
            "type": "string"
          },
          "fechaNacimiento": {
            "minLength": 1,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
          },
          "telefonoCelular": {
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      }
    }
  }
}